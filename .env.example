# ─────────────── AgendaLux · variáveis de ambiente ───────────────
# Copie para .env.local (local) e preencha no Vercel → Settings → Environment Variables.

# URL do projeto Supabase (Settings → API → Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave de SERVICE ROLE (Settings → API → service_role) — NUNCA vai para o navegador
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role

# Bucket de imagens (criado pelo supabase/schema.sql)
SUPABASE_BUCKET=assets

# Ambiente: production | preview | development
NODE_ENV=production
